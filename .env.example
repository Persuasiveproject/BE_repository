# Local development only. Copy to .env and replace the two placeholder secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=ye
POSTGRES_USER=ye
POSTGRES_PASSWORD=replace-with-a-random-local-db-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Container service name: redis. Databases 0/1 share the same Redis instance.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Local verification only: beat sends config.tasks.ping every 30 seconds.
CELERY_HEARTBEAT_ENABLED=true
